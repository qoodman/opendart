# 서버용 설정. 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# DART OpenAPI 인증키 (https://opendart.fss.or.kr → 인증키 신청, 무료)
DART_API_KEY=

# 조회 기간: 오늘부터 며칠 전까지 (기본 365일). 시작일을 고정하려면 DART_START=20260101
DART_DAYS=365
DART_START=

# 검색 조건 (보통 그대로)
DART_KEYWORD=상황보고
DART_BODY_WORD=단순투자

# 폰 푸시 알림 (ntfy 앱). 부동산 앱 .env 의 NTFY_TOPIC 과 같게 두면 한 앱에서 같이 받습니다
NTFY_TOPIC=
# 알림을 눌렀을 때 열 대시보드 주소 (예: https://realestate.xxxx.ts.net:8443)
DASHBOARD_URL=
# 대시보드 위쪽 '부동산 ↗' 링크 (예: https://realestate.xxxx.ts.net)
REALESTATE_URL=

# 제출일 종가 넣기 (네이버 증권). 끄려면 0
DART_PRICES=1

# 작은 서버용: 동시 다운로드 수, 동시 분석 수
DART_WORKERS=4
DART_PARSE_WORKERS=1

# 데이터 저장 위치 (비워두면 이 폴더 안의 data/)
DART_DATA_DIR=
