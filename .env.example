# 한국투자증권 KIS Developers 에서 발급 (https://apiportal.koreainvestment.com)
# 이 파일을 .env 로 복사해서 채우세요. .env 는 git 에 올라가지 않습니다.

# 모의투자 (기본)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT=12345678-01

# 실전 (--live 로 실행할 때만 사용)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=12345678-01
# 실전 매매를 허용하려면 yes
KIS_ALLOW_LIVE=no

# 체결통보 구독용 HTS ID (없으면 체결이 반영되지 않음)
KIS_HTS_ID=

# 초당 호출 수 (비우면 실전 15, 모의 2)
KIS_MAX_RPS=
